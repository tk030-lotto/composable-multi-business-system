generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. 監査ログテーブル
model audit_logs {
  id         Int       @id @default(autoincrement())
  table_name String    @db.VarChar(50)
  record_id  Int
  action     String    @db.VarChar(20)
  changed_by String?   @default("SYSTEM") @db.VarChar(255)
  old_data   Json?
  new_data   Json?
  changed_at DateTime? @default(now()) @db.Timestamptz(6)
}

// 2. 冪等性キー管理テーブル
model idempotency_keys {
  id            Int       @id @default(autoincrement())
  key           String    @unique @db.VarChar(255)
  request_hash  String    @db.VarChar(255)
  response_body String    @db.Text
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

// 4. トリガーの適用（各主要テーブルに自動バインド）
// 顧客管理
model customers {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(50)
  status        String    @default("新規") @db.VarChar(50)
  custom_fields Json?     @default("{}")
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  reservations reservations[]
}

// 商品・在庫マスター
model products {
  id             Int       @id @default(autoincrement())
  product_code   String    @db.VarChar(50) // UNIQUE制約は部分インデックス側で定義されるためPrismaの@uniqueは付けない
  name           String    @db.VarChar(255)
  sales_price    Decimal   @default(0.00) @db.Decimal(12, 2)
  purchase_price Decimal   @default(0.00) @db.Decimal(12, 2)
  logical_stock  Int       @default(0)
  physical_stock Int       @default(0)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)
}

// 売上・見積管理
model sales_orders {
  id             Int       @id @default(autoincrement())
  sales_no       String    @db.VarChar(50)
  customer_id    Int?
  order_type     String    @default("ACTUAL") @db.VarChar(20)
  payment_method String    @default("CASH") @db.VarChar(20)
  status         String    @default("ORDERED") @db.VarChar(20)
  payment_status String    @default("UNPAID") @db.VarChar(20)
  total_amount   Decimal   @db.Decimal(12, 2)
  sales_date     DateTime  @db.Date
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  items sales_order_items[]
}

model sales_order_items {
  id             Int          @id @default(autoincrement())
  sales_order_id Int
  product_id     Int?
  quantity       Int
  unit_price     Decimal      @db.Decimal(12, 2)

  sales_order    sales_orders @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
}

// 仕入管理
model purchase_orders {
  id             Int       @id @default(autoincrement())
  purchase_no    String    @db.VarChar(50)
  supplier_name  String    @db.VarChar(255)
  status         String    @default("ORDERED") @db.VarChar(20)
  expense_status String    @default("UNPAID") @db.VarChar(20)
  total_amount   Decimal   @db.Decimal(12, 2)
  purchase_date  DateTime  @db.Date
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime? @db.Timestamptz(6)

  items purchase_order_items[]
}

model purchase_order_items {
  id                Int             @id @default(autoincrement())
  purchase_order_id Int
  product_id        Int?
  quantity          Int
  unit_price        Decimal         @db.Decimal(12, 2)

  purchase_order    purchase_orders @relation(fields: [purchase_order_id], references: [id], onDelete: Cascade)
}

// システム設定テーブル
model settings {
  key        String    @id @db.VarChar(255)
  value      Json
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

// 予約管理テーブル
model reservations {
  id          Int       @id @default(autoincrement())
  customer_id Int
  title       String    @db.VarChar(255)
  start_time  DateTime  @db.Timestamptz(6)
  end_time    DateTime  @db.Timestamptz(6)
  memo        String?   @db.Text
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)

  customer customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
}
